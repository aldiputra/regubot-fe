{
  "name": "bedrock-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:prep && next dev",
    "dev:prep": "mv -f babel.config.js babel.config.js.bak 2>/dev/null || true",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:prep && jest",
    "test:prep": "mv -f babel.config.js.bak babel.config.js 2>/dev/null || true",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-jest": "^30.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "eslint-plugin-spellcheck": "^0.0.20",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "^5"
  }
}
